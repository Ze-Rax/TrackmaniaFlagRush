{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player",
  "description": "Represents a player, including identity and position.",
  "type": "object",
  "properties": {
    "login": {
      "type": "string",
      "description": "Player login name"
    },
    "webServicesUserId": {
      "type": "string",
      "description": "Web service user ID"
    },
    "name": {
      "type": "string",
      "description": "Displayed player name"
    },
    "clan": {
      "type": "integer",
      "description": "Clan/team number"
    },
    "position": {
      "$ref": "Position.json"
    }
  },
  "required": [
    "login",
    "webServicesUserId",
    "name",
    "clan",
    "position"
  ]
}