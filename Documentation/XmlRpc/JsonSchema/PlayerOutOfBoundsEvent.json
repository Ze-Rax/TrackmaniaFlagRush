{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayerOutOfBoundsEvent",
  "description": "Emitted when a player enters an out-of-bounds trigger.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer"
    },
    "player": {
      "$ref": "Player.json"
    }
  },
  "required": [
    "timestamp",
    "player"
  ]
}