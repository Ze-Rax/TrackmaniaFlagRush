{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SegmentEndWithScoresEvent",
  "description": "Event marking end of a match/map/round, with scores.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Scores per team (length = 2)"
    },
    "winnerClan": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "description": "Winning clan (0 = draw)"
    }
  },
  "required": [
    "timestamp",
    "scores",
    "winnerClan"
  ]
}